generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ClientStatus {
  active
  inactive
}

enum ManagerRole {
  admin
  manager
  agency
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trial
}

enum GoalMetric {
  leads
  cpl
  roas
  ctr
  clicks
  impressions
  purchases
  purchase_value
  messaging
  cpmsg
}

enum AlertType {
  budget_warning
  budget_exceeded
  budget_underuse
  goal_behind
  goal_reached
  sync_failed
  sync_success
  account_issue
}

enum AlertSeverity {
  info
  warning
  critical
  success
}

enum TaskStatus {
  backlog
  todo
  in_progress
  review
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

model Manager {
  id           String       @id @db.Char(36)
  name         String       @db.VarChar(100)
  email        String       @unique @db.VarChar(150)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  company      String?      @db.VarChar(100)
  role         ManagerRole  @default(manager)
  plan         String       @default("pro") @db.VarChar(30)
  maxClients   Int?         @map("max_clients")
  active       Boolean      @default(true)
  phone        String?      @db.VarChar(20)
  whatsappNotify Boolean    @default(false) @map("whatsapp_notify")
  healthCheckTimes String?    @default("08,12,18") @map("health_check_times") @db.VarChar(50)
  weeklySummary Boolean     @default(false) @map("weekly_summary")
  agencyId         String?      @map("agency_id") @db.Char(36)
  maxSeats         Int?         @map("max_seats")
  subscriptionStatus SubscriptionStatus @default(active) @map("subscription_status")
  subscriptionEndsAt DateTime?  @map("subscription_ends_at") @db.Timestamp(0)
  billingPeriod    String?      @map("billing_period") @db.VarChar(20)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)

  refreshTokens RefreshToken[]
  managerClients ManagerClient[]
  invites       Invite[]      @relation("CreatedInvites")
  usedInvites   Invite[]      @relation("UsedInvites")
  budgets       ClientBudget[]
  goals         ClientGoal[]
  alerts        Alert[]
  tasks         Task[]
  agency        Manager?  @relation("AgencyManagers", fields: [agencyId], references: [id], onDelete: SetNull)
  agencyMembers Manager[] @relation("AgencyManagers")

  @@map("managers")
}

model Invite {
  id        String   @id @db.Char(36)
  token     String   @unique @db.Char(64)
  email     String?  @db.VarChar(150)
  plan      String   @default("pro") @db.VarChar(30)
  used      Boolean  @default(false)
  usedById  String?  @map("used_by") @db.Char(36)
  usedAt    DateTime? @map("used_at") @db.Timestamp(0)
  createdBy String   @map("created_by") @db.Char(36)
  expiresAt DateTime @map("expires_at") @db.Timestamp(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  creator Manager  @relation("CreatedInvites", fields: [createdBy], references: [id], onDelete: Cascade)
  usedBy   Manager? @relation("UsedInvites", fields: [usedById], references: [id], onDelete: SetNull)

  @@map("invites")
}

model ManagerClient {
  managerId String   @map("manager_id") @db.Char(36)
  clientId  String   @map("client_id") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [actId], onDelete: Cascade)

  @@id([managerId, clientId])
  @@map("manager_clients")
}

model RefreshToken {
  id        String   @id @db.Char(36)
  managerId String   @map("manager_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamp(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([managerId])
  @@map("refresh_tokens")
}

model Client {
  id              Int          @id @default(autoincrement())
  clientName      String       @map("client_name") @db.VarChar(100)
  actId           String       @unique @map("act_id") @db.VarChar(50)
  accessToken     String       @map("access_token") @db.Text
  customEventId   String?      @map("custom_event_id") @db.VarChar(100)
  isEcommerce     Boolean?     @default(false) @map("is_ecommerce")
  status          ClientStatus @default(active)
  accountStatus   Int?         @map("account_status")
  disableReason   Int?         @map("disable_reason")
  healthLastCheck DateTime?    @map("health_last_check") @db.Timestamp(0)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(0)

  adsPerformance         AdPerformance[]
  audiencePerformance    AdAudiencePerformance[]
  placementPerformance   AdPlacementPerformance[]
  regionPerformance      AdRegionPerformance[]
  managerClients         ManagerClient[]
  budgets                ClientBudget[]
  goals                  ClientGoal[]
  alerts                 Alert[]
  tasks                  Task[]

  @@map("clients_config")
}

model AdPerformance {
  id                    BigInt   @id @default(autoincrement())
  date                  DateTime @db.Date
  clientId              String   @map("client_id") @db.VarChar(50)
  adId                  String   @map("ad_id") @db.VarChar(50)
  adName                String?  @map("ad_name") @db.VarChar(255)
  campaignName          String?  @map("campaign_name") @db.VarChar(255)
  campaignId            String?  @map("campaign_id") @db.VarChar(50)
  reach                 Int?     @default(0)
  impressions           Int?     @default(0)
  spend                 Decimal? @default(0.0000) @db.Decimal(15, 4)
  linkClicks            Int?     @default(0) @map("link_clicks")
  ctr                   Decimal? @default(0.0000) @db.Decimal(10, 4)
  messagingConversations Int?    @default(0) @map("messaging_conversations")
  leads                 Int?     @default(0)
  leadsForm             Int?     @default(0) @map("leads_form")
  pageViews             Int?     @default(0) @map("page_views")
  addToCart             Int?     @default(0) @map("add_to_cart")
  initiateCheckout      Int?     @default(0) @map("initiate_checkout")
  purchases             Int?     @default(0)
  purchaseValue         Decimal? @default(0.0000) @db.Decimal(15, 4) @map("purchase_value")
  customConversionCount Int?     @default(0) @map("custom_conversion_count")
  customConversionValue Decimal? @default(0.0000) @db.Decimal(15, 4) @map("custom_conversion_value")
  previewLink           String?  @map("preview_link") @db.Text
  adStatus              String?  @map("ad_status") @db.VarChar(50)
  campaignStatus        String?  @map("campaign_status") @db.VarChar(50)
  totalConversionValue  Decimal? @default(0.0000) @db.Decimal(15, 4) @map("total_conversion_value")
  roas                  Decimal? @default(0.0000) @db.Decimal(10, 4)
  creativeUrl           String?  @map("creative_url") @db.VarChar(500)
  creativeType          String?  @map("creative_type") @db.VarChar(20)
  pageLikes             Int?     @default(0) @map("page_likes")

  client                Client   @relation(fields: [clientId], references: [actId], onDelete: Cascade)

  @@unique([date, adId], map: "unique_ad_date")
  @@index([clientId], map: "idx_client")
  @@index([date], map: "idx_date")
  @@map("meta_ads_performance")
}

model AdAudiencePerformance {
  id                     BigInt   @id @default(autoincrement())
  date                   DateTime @db.Date
  clientId               String   @map("client_id") @db.VarChar(50)
  adId                   String   @map("ad_id") @db.VarChar(50)
  adName                 String?  @map("ad_name") @db.VarChar(255)
  campaignName           String?  @map("campaign_name") @db.VarChar(255)
  campaignId             String?  @map("campaign_id") @db.VarChar(50)
  gender                 String   @db.VarChar(20)
  ageRange               String   @map("age_range") @db.VarChar(10)
  reach                  Int?     @default(0)
  impressions            Int?     @default(0)
  spend                  Decimal? @default(0.0000) @db.Decimal(15, 4)
  linkClicks             Int?     @default(0) @map("link_clicks")
  ctr                    Decimal? @default(0.0000) @db.Decimal(10, 4)
  messagingConversations Int?     @default(0) @map("messaging_conversations")
  leads                  Int?     @default(0)
  leadsForm              Int?     @default(0) @map("leads_form")
  pageViews              Int?     @default(0) @map("page_views")
  addToCart              Int?     @default(0) @map("add_to_cart")
  initiateCheckout       Int?     @default(0) @map("initiate_checkout")
  purchases              Int?     @default(0)
  purchaseValue          Decimal? @default(0.0000) @db.Decimal(15, 4) @map("purchase_value")
  customConversionCount  Int?     @default(0) @map("custom_conversion_count")
  customConversionValue  Decimal? @default(0.0000) @db.Decimal(15, 4) @map("custom_conversion_value")
  totalConversionValue   Decimal? @default(0.0000) @db.Decimal(15, 4) @map("total_conversion_value")
  roas                   Decimal? @default(0.0000) @db.Decimal(10, 4)

  client                 Client   @relation(fields: [clientId], references: [actId], onDelete: Cascade)

  @@unique([date, adId, gender, ageRange], map: "unique_audience_ad_date")
  @@index([clientId], map: "idx_audience_client")
  @@index([date], map: "idx_audience_date")
  @@map("ad_audience_performance")
}

model AdPlacementPerformance {
  id                     BigInt   @id @default(autoincrement())
  date                   DateTime @db.Date
  clientId               String   @map("client_id") @db.VarChar(50)
  adId                   String   @map("ad_id") @db.VarChar(50)
  adName                 String?  @map("ad_name") @db.VarChar(255)
  campaignName           String?  @map("campaign_name") @db.VarChar(255)
  campaignId             String?  @map("campaign_id") @db.VarChar(50)
  platform               String   @db.VarChar(50)
  reach                  Int?     @default(0)
  impressions            Int?     @default(0)
  spend                  Decimal? @default(0.0000) @db.Decimal(15, 4)
  linkClicks             Int?     @default(0) @map("link_clicks")
  ctr                    Decimal? @default(0.0000) @db.Decimal(10, 4)
  messagingConversations Int?     @default(0) @map("messaging_conversations")
  leads                  Int?     @default(0)
  leadsForm              Int?     @default(0) @map("leads_form")
  pageViews              Int?     @default(0) @map("page_views")
  addToCart              Int?     @default(0) @map("add_to_cart")
  initiateCheckout       Int?     @default(0) @map("initiate_checkout")
  purchases              Int?     @default(0)
  purchaseValue          Decimal? @default(0.0000) @db.Decimal(15, 4) @map("purchase_value")
  customConversionCount  Int?     @default(0) @map("custom_conversion_count")
  customConversionValue  Decimal? @default(0.0000) @db.Decimal(15, 4) @map("custom_conversion_value")
  totalConversionValue   Decimal? @default(0.0000) @db.Decimal(15, 4) @map("total_conversion_value")
  roas                   Decimal? @default(0.0000) @db.Decimal(10, 4)

  client                 Client   @relation(fields: [clientId], references: [actId], onDelete: Cascade)

  @@unique([date, adId, platform], map: "unique_placement_ad_date")
  @@index([clientId], map: "idx_placement_client")
  @@index([date], map: "idx_placement_date")
  @@map("ad_placement_performance")
}

model AdRegionPerformance {
  id                     BigInt   @id @default(autoincrement())
  date                   DateTime @db.Date
  clientId               String   @map("client_id") @db.VarChar(50)
  adId                   String   @map("ad_id") @db.VarChar(50)
  adName                 String?  @map("ad_name") @db.VarChar(255)
  campaignName           String?  @map("campaign_name") @db.VarChar(255)
  campaignId             String?  @map("campaign_id") @db.VarChar(50)
  region                 String   @db.VarChar(100)
  reach                  Int?     @default(0)
  impressions            Int?     @default(0)
  spend                  Decimal? @default(0.0000) @db.Decimal(15, 4)
  linkClicks             Int?     @default(0) @map("link_clicks")
  ctr                    Decimal? @default(0.0000) @db.Decimal(10, 4)
  messagingConversations Int?     @default(0) @map("messaging_conversations")
  leads                  Int?     @default(0)
  leadsForm              Int?     @default(0) @map("leads_form")
  pageViews              Int?     @default(0) @map("page_views")
  addToCart              Int?     @default(0) @map("add_to_cart")
  initiateCheckout       Int?     @default(0) @map("initiate_checkout")
  purchases              Int?     @default(0)
  purchaseValue          Decimal? @default(0.0000) @db.Decimal(15, 4) @map("purchase_value")
  customConversionCount  Int?     @default(0) @map("custom_conversion_count")
  customConversionValue  Decimal? @default(0.0000) @db.Decimal(15, 4) @map("custom_conversion_value")
  totalConversionValue   Decimal? @default(0.0000) @db.Decimal(15, 4) @map("total_conversion_value")
  roas                   Decimal? @default(0.0000) @db.Decimal(10, 4)

  client                 Client   @relation(fields: [clientId], references: [actId], onDelete: Cascade)

  @@unique([date, adId, region], map: "unique_region_ad_date")
  @@index([clientId], map: "idx_region_client")
  @@index([date], map: "idx_region_date")
  @@map("ad_region_performance")
}

model Alert {
  id         String        @id @db.Char(36)
  managerId  String        @map("manager_id") @db.Char(36)
  clientId   String        @map("client_id") @db.VarChar(50)
  type       AlertType
  severity   AlertSeverity
  title      String        @db.VarChar(200)
  message    String        @db.Text
  read       Boolean       @default(false)
  dismissed  Boolean       @default(false)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamp(0)

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [actId], onDelete: Cascade)

  @@index([managerId, read, dismissed], map: "idx_alert_manager_unread")
  @@index([managerId, createdAt], map: "idx_alert_manager_date")
  @@map("alerts")
}

model Task {
  id          String       @id @db.Char(36)
  managerId   String       @map("manager_id") @db.Char(36)
  clientId    String?      @map("client_id") @db.VarChar(50)
  title       String       @db.VarChar(200)
  description String?      @db.Text
  status      TaskStatus   @default(backlog)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @map("due_date") @db.Date
  position    Int          @default(0)
  alertId     String?      @map("alert_id") @db.Char(36)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [actId], onDelete: Cascade)

  @@index([managerId, status, position], map: "idx_task_manager_status")
  @@map("tasks")
}

model AppSettings {
  key       String @id @db.VarChar(100)
  value     String @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("app_settings")
}

model ClientBudget {
  id           String   @id @db.Char(36)
  managerId    String   @map("manager_id") @db.Char(36)
  clientId     String   @map("client_id") @db.VarChar(50)
  month        DateTime @db.Date
  budgetAmount Decimal  @map("budget_amount") @db.Decimal(15, 4)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [actId], onDelete: Cascade)

  @@unique([managerId, clientId, month])
  @@map("client_budgets")
}

model ClientGoal {
  id           String      @id @db.Char(36)
  managerId    String      @map("manager_id") @db.Char(36)
  clientId     String      @map("client_id") @db.VarChar(50)
  metric       GoalMetric
  targetValue  Decimal     @map("target_value") @db.Decimal(15, 4)
  month        DateTime    @db.Date
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamp(0)

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [actId], onDelete: Cascade)

  @@unique([managerId, clientId, metric, month])
  @@map("client_goals")
}
