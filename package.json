  "scripts": {
    "dev": "concurrently -n api,front -c blue,green \"tsx watch server/src/app.ts\" \"npm run dev --prefix client\"",
    "dev:api": "tsx watch server/src/app.ts",
    "dev:client": "npm run dev --prefix client",
    "build": "tsc -p server/tsconfig.json",
    "start": "node server/dist/app.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
