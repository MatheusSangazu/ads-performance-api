# ===========================================
# Growth Ads API - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ===========================================

# --- Banco de Dados MySQL/MariaDB ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=growth_ads
DB_DIALECT=mysql
DATABASE_URL=mysql://root:sua_senha_aqui@localhost:3306/growth_ads

# --- Servidor ---
PORT=3001

# --- JWT ---
# Gere um secret seguro com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cole_o_jwt_secret_gerado_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Admin Padrão (criado no primeiro startup) ---
ADMIN_EMAIL=admin@growthads.com
ADMIN_PASSWORD=changeme123

# --- CORS (URL do frontend em produção) ---
# Em desenvolvimento, deixe vazio para aceitar todas as origens
# Em produção, coloque a URL do frontend: https://seu-frontend.com
CORS_ORIGIN=

# --- Evolution API (WhatsApp - Opcional) ---
EVO_API_URL=
EVO_API_KEY=
EVO_INSTANCE_NAME=

# --- Meta/Facebook OAuth ---
META_APP_ID=seu_app_id_aqui
META_APP_SECRET=seu_app_secret_aqui
